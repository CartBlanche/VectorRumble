<Project>
  <PropertyGroup>
    <AssemblyVersion>0.1.0.7</AssemblyVersion>
    <FileVersion>0.1.0.7</FileVersion>
    <Version>0.1.0</Version>
    <AssemblyTitle>Vector Rumble</AssemblyTitle>
    <AssemblyCompany>SoftSavage</AssemblyCompany>
    <AssemblyProduct>Vector Rumble</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2026 SoftSavage</AssemblyCopyright>
    <AssemblyDescription>Vector Rumble</AssemblyDescription>
  </PropertyGroup>
  <PropertyGroup>
    <MonoGameVersion>3.8.6.1</MonoGameVersion>
    <!-- VectorEngine lives in its own repo, cloned next to this one; pass -p:EngineDir=/path/to/VectorEngine/ to use another copy -->
    <EngineDir Condition="'$(EngineDir)' == ''">$(MSBuildThisFileDirectory)..\VectorEngine\</EngineDir>
  </PropertyGroup>
</Project>
