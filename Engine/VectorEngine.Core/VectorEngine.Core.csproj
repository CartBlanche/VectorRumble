<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- a method that silently hides an inherited one is never called through the base class (this broke the waypoint actors once) -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0114;CS0108</WarningsAsErrors>
    <RootNamespace>VectorEngine</RootNamespace>
    <AssemblyName>VectorEngine.Core</AssemblyName>
    <AssemblyDescription>Shared vector game engine core</AssemblyDescription>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-time only: the game head supplies the real platform framework. No Net package here. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup Condition="'$(PerfOverlay)' == 'true'">
    <!-- dotnet build -c Release -p:PerfOverlay=true: puts the frame time / GC / draw call overlay in a Release build -->
    <DefineConstants>$(DefineConstants);PERF_OVERLAY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VectorEngine.Tests" />
    <InternalsVisibleTo Include="VectorRumble.Tests" />
  </ItemGroup>
</Project>
