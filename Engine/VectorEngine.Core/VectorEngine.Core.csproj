<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VectorEngine</RootNamespace>
    <AssemblyName>VectorEngine.Core</AssemblyName>
    <AssemblyDescription>Shared vector game engine core</AssemblyDescription>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-time only: the game head supplies the real platform framework. No Net package here. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VectorEngine.Tests" />
    <InternalsVisibleTo Include="VectorRumble.Tests" />
  </ItemGroup>
</Project>
