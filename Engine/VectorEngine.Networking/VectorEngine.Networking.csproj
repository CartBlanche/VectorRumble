<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- a method that silently hides an inherited one is never called through the base class (this broke the waypoint actors once) -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0114;CS0108</WarningsAsErrors>
    <RootNamespace>VectorEngine.Networking</RootNamespace>
    <AssemblyName>VectorEngine.Networking</AssemblyName>
    <AssemblyDescription>Optional LAN networking for Vector Engine games</AssemblyDescription>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-time only: the game head supplies the real platform framework. This is the only engine project with the Net package. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MonoGame.Xna.Framework.Net" Version="1.0.0-preview.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VectorEngine.Tests" />
    <InternalsVisibleTo Include="VectorRumble.Tests" />
  </ItemGroup>
</Project>
