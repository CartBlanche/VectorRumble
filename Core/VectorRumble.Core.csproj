<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- a method that silently hides an inherited one is never called through the base class (this broke the waypoint actors once) -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0114;CS0108</WarningsAsErrors>
    <DefineConstants>$(DefineConstants);AUDIO;SHADER_EFFECTS</DefineConstants>
    <AssemblyDescription>Vector Rumble Core</AssemblyDescription>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engine\VectorEngine.Core\VectorEngine.Core.csproj" />
    <!-- optional engine part: LAN networking (the only one that needs the Net package) -->
    <ProjectReference Include="..\Engine\VectorEngine.Networking\VectorEngine.Networking.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PerfOverlay)' == 'true'">
    <!-- dotnet build -c Release -p:PerfOverlay=true: puts the frame time / GC / draw call overlay in a Release build -->
    <DefineConstants>$(DefineConstants);PERF_OVERLAY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VectorRumble.Tests" />
  </ItemGroup>
   <ItemGroup>
    <EmbeddedResource Update="Strings.resx">
      <Link>Strings.resx</Link>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Strings.es.resx">
      <Link>Strings.es.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="Strings.de.resx">
      <Link>Strings.de.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="Strings.fr.resx">
      <Link>Strings.fr.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="Strings.zh-CN.resx">
      <Link>Strings.zh-CN.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="Strings.ja.resx">
      <Link>Strings.ja.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="Strings.ko.resx">
      <Link>Strings.ko.resx</Link>
    </EmbeddedResource>
  </ItemGroup>
</Project>